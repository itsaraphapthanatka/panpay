# PanPay backend base URL (host → published backend port, e.g. 8001; inside docker → http://backend:8000)
PANPAY_URL=http://localhost:8000
# Merchant secret API key (Dashboard → API Keys → sk_live_...) — confirms checkout charges
PANPAY_API_KEY=
# Optional platform ingest key (Settings → topup_ingest_key). When set, the bridge
# confirms charges platform-wide (/bank/incoming/platform, any merchant sharing the
# watched account) and merchant credit top-ups (/topup/incoming). When blank, it
# matches only this API key's charges via /v1/line/transfer.
PANPAY_INGEST_KEY=
# Optional: PromptPay id of the bank account this bridge watches. Scopes platform
# charge matching to that account. Leave blank to match by amount across all accounts.
PANPAY_ACCOUNT=
# Optional: LINE userIds allowed to query the wallet balance by messaging the bot
# "ยอดเงิน"/"balance" (comma-separated). Empty = reply to anyone (not recommended).
PANPAY_BALANCE_ALLOWED_IDS=
