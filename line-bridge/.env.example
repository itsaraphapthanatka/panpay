# PanPay backend base URL (host → published backend port, e.g. 8001; inside docker → http://backend:8000)
PANPAY_URL=http://localhost:8000
# Merchant secret API key (Dashboard → API Keys → sk_live_...) — confirms checkout charges
PANPAY_API_KEY=
# Optional platform top-up ingest key (Settings → topup_ingest_key). When set, the
# bridge also confirms merchant credit top-ups (/topup/incoming) for transfers that
# don't match any pending charge. Leave blank to handle checkout charges only.
PANPAY_INGEST_KEY=
