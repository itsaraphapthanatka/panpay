# panpay backend base URL (no trailing slash)
PANPAY_API_BASE=https://punpay.petgo.asia

# Merchant secret API key (starts with sk_). Create one in the merchant dashboard.
PANPAY_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# Optional: comma-separated LINE userIds allowed to query the balance.
# Leave empty to reply to anyone (NOT recommended).
ALLOWED_LINE_IDS=
